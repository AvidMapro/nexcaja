# ============================================================
# .gitignore para NexCaja
# Proyecto: Spring Boot (Maven) + HTML/CSS/JS puro
# Universidad Central del Ecuador
# ============================================================

# ------------------------------------------------------------
# JAVA Y MAVEN
# ------------------------------------------------------------
backend/target/
backend/.mvn/wrapper/maven-wrapper.jar

# ------------------------------------------------------------
# INTELLIJ IDEA
# ------------------------------------------------------------
.idea/
*.iws
*.iml
*.ipr
out/

# ------------------------------------------------------------
# ECLIPSE / STS
# ------------------------------------------------------------
.classpath
.project
.settings/
.springBeans
.sts4-cache/

# ------------------------------------------------------------
# VISUAL STUDIO CODE
# ------------------------------------------------------------
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# ------------------------------------------------------------
# SISTEMA OPERATIVO
# ------------------------------------------------------------
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*~

# ------------------------------------------------------------
# LOGS Y ARCHIVOS TEMPORALES
# ------------------------------------------------------------
*.log
logs/
backend/logs/
spring.log

# ------------------------------------------------------------
# CREDENCIALES Y SECRETOS — NUNCA SUBIR AL REPO
#
# application.properties contiene la URL y contraseña
# de Supabase. Si se sube a GitHub queda expuesta
# públicamente para siempre en el historial de commits.
#
# Flujo correcto:
#   1. El repo tiene application.properties con placeholders
#   2. Cada desarrollador edita su copia LOCAL con sus credenciales
#   3. Git nunca trackea ese archivo gracias a esta línea
# ------------------------------------------------------------
backend/src/main/resources/application.properties

# Otros archivos de secretos
.env
.env.local
.env.production
secrets.properties
application-local.properties
application-prod.properties

# ------------------------------------------------------------
# ARCHIVOS EMPAQUETADOS
# ------------------------------------------------------------
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# ------------------------------------------------------------
# NODE.JS (por si se agrega npm en el futuro)
# ------------------------------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ------------------------------------------------------------
# COBERTURA DE PRUEBAS
# ------------------------------------------------------------
backend/target/site/
backend/target/surefire-reports/
